# ============================================
# ANHA Trading - Production Environment
# For Hostinger VPS Deployment
# ============================================

# ============================================
# APPLICATION SETTINGS
# ============================================
APP_NAME=ANHA Trading
ENVIRONMENT=production
BASE_URL=https://your-domain.com

# ============================================
# SECURITY - CRITICAL: Change these in production!
# ============================================
# Generate a strong secret key:
# python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=change-this-to-a-secure-secret-key-minimum-32-characters

# Token expiration (in minutes)
ACCESS_TOKEN_EXPIRE_MINUTES=720
RESET_TOKEN_EXPIRE_MINUTES=30

# ============================================
# DATABASE CONFIGURATION
# ============================================
# These credentials are used by both the app and PostgreSQL container
POSTGRES_USER=anha_user
# IMPORTANT: Change this password in production!
POSTGRES_PASSWORD=your-secure-random-password-here
POSTGRES_DB=anha_db

# The DATABASE_URL is automatically constructed in docker-compose.prod.yml
# Format: postgresql+asyncpg://USER:PASSWORD@db:5432/DB_NAME

# ============================================
# DATABASE OPTIONS
# ============================================
AUTO_CREATE_DB=true
DB_CONNECT_TIMEOUT_SECONDS=30
DB_CONNECT_SSL=false

# ============================================
# SMTP / EMAIL CONFIGURATION
# ============================================
# Hostinger SMTP settings (update with your credentials)
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=587
SMTP_USER=your-email@your-domain.com
SMTP_PASSWORD=your-smtp-password
SMTP_FROM_EMAIL=your-email@your-domain.com
SMTP_TLS=true

# ============================================
# REDIS CACHE (Optional but recommended)
# ============================================
REDIS_URL=redis://redis:6379/0

# ============================================
# MONITORING & LOGGING
# ============================================
LOG_LEVEL=INFO
SENTRY_DSN=

# ============================================
# FEATURE FLAGS
# ============================================
ENABLE_REGISTRATION=true
ENABLE_PASSWORD_RESET=true
ENABLE_EMAIL_VERIFICATION=true
